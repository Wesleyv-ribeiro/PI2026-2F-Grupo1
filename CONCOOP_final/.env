# String de conexão do PostgreSQL
DATABASE_URL=postgresql://postgres:Morango@127.0.0.1:5432/agrolink

# Chave de API do Google Gemini, usada para verificar automaticamente se os
# produtos cadastrados por produtores contêm conteúdo ilícito, proibido ou
# não regulamentado antes de serem publicados no Mercado.
# Obtenha a sua em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo do Gemini usado na verificação (opcional, tem um valor padrão)
GEMINI_MODEL=gemini-2.0-flash

# --- Verificação de e-mail no cadastro (envio via Gmail) ---
# Conta Gmail que envia o e-mail de confirmação de cadastro.
GMAIL_USER=

# Senha de APP do Gmail (NÃO é a senha normal da conta).
# Gerar em: Conta Google > Segurança > Verificação em duas etapas > Senhas de app
GMAIL_APP_PASSWORD=

# Nome exibido como remetente do e-mail (opcional)
GMAIL_SENDER_NAME=CONCOOP